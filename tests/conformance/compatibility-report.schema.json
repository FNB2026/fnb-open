{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FNB2026/fnb-open/v0.1.0-preview.1/tests/conformance/compatibility-report.schema.json",
  "title": "FNB Protocol Compatibility Report",
  "description": "Machine-readable results from public FNB protocol conformance checks. A passing report is not product, security, or legal certification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "protocol_release",
    "runner",
    "subject",
    "status",
    "checks"
  ],
  "properties": {
    "format_version": {
      "const": "1.0"
    },
    "protocol_release": {
      "type": "string",
      "minLength": 1
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "release_bundle",
            "implementation"
          ]
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skip"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
